{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v7-redacted-first-pass-run-record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "benchmarkId", "runId", "blindId", "scenario", "condition", "replica", "branch", "setup", "task", "timing", "usage", "cost", "quality", "fidelity", "usability", "validity"],
  "properties": {
    "schemaVersion": {"const": 1},
    "benchmarkId": {"const": "benchmark-v7-luna-xhigh-n3-2026-09-01"},
    "runId": {"type": "string", "pattern": "^v7-[a-z0-9-]+-r[1-3]$"},
    "blindId": {"type": "string", "pattern": "^vz-[0-9a-f]{6}$"},
    "scenario": {"enum": ["new-project", "small-project", "large-project"]},
    "condition": {"enum": ["plain", "bmad", "prist", "classic-spec"]},
    "replica": {"type": "integer", "minimum": 1, "maximum": 3},
    "branch": {"type": "string", "pattern": "^v7/b[0-9a-f]{10}$"},
    "setup": {"type": "object", "additionalProperties": false, "required": ["lineageId", "commit", "tree", "fingerprint"], "properties": {"lineageId": {"type": "string"}, "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "task": {"type": "object", "additionalProperties": false, "required": ["taskId", "hostId", "requestedModel", "requestedReasoning", "actualModel", "actualReasoning", "firstPassOnly", "repairTurns", "infrastructureRetryIndex"], "properties": {"taskId": {"type": "string", "minLength": 1}, "hostId": {"type": "string", "minLength": 1}, "requestedModel": {"const": "gpt-5.6-luna"}, "requestedReasoning": {"const": "xhigh"}, "actualModel": {"const": "gpt-5.6-luna"}, "actualReasoning": {"const": "xhigh"}, "firstPassOnly": {"const": true}, "repairTurns": {"const": 0}, "infrastructureRetryIndex": {"type": "integer", "minimum": 0, "maximum": 1}}},
    "timing": {"type": "object", "additionalProperties": false, "required": ["dispatchAt", "taskStartAt", "firstActivityAt", "lastActivityAt", "finalResponseAt", "taskElapsedMs", "agentActiveMs", "humanWaitingMs", "externalChecksMs"], "properties": {"dispatchAt": {"type": "string", "format": "date-time"}, "taskStartAt": {"type": "string", "format": "date-time"}, "firstActivityAt": {"type": "string", "format": "date-time"}, "lastActivityAt": {"type": "string", "format": "date-time"}, "finalResponseAt": {"type": "string", "format": "date-time"}, "taskElapsedMs": {"type": "integer", "minimum": 0}, "agentActiveMs": {"type": "integer", "minimum": 0}, "humanWaitingMs": {"type": "integer", "minimum": 0}, "externalChecksMs": {"type": "integer", "minimum": 0}}},
    "usage": {"$ref": "usage-record.schema.json"},
    "cost": {"type": "object", "additionalProperties": false, "required": ["taskOnlyUsd", "fullCycleUsd", "organizerProvisioningUsd", "methodInstallUsd", "baselineCanonUsd", "activationCanaryUsd", "lateChangeTaskUsd", "externalEvaluationUsd"], "properties": {"taskOnlyUsd": {"type": "number", "minimum": 0}, "fullCycleUsd": {"type": "number", "minimum": 0}, "organizerProvisioningUsd": {"type": "number", "minimum": 0}, "methodInstallUsd": {"type": "number", "minimum": 0}, "baselineCanonUsd": {"type": "number", "minimum": 0}, "activationCanaryUsd": {"type": "number", "minimum": 0}, "lateChangeTaskUsd": {"type": "number", "minimum": 0}, "externalEvaluationUsd": {"type": "number", "minimum": 0}}},
    "snapshot": {"type": "object", "additionalProperties": false, "required": ["head", "tree", "status", "fileHashes", "immutableCopyPath"], "properties": {"head": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "status": {"type": "string"}, "fileHashes": {"type": "array"}, "immutableCopyPath": {"type": "string"}}},
    "snapshotId": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "interventions": {"type": "object", "additionalProperties": false, "required": ["clarifications", "answers", "repairTurns"], "properties": {"clarifications": {"type": "integer", "minimum": 0, "maximum": 2}, "answers": {"type": "array"}, "repairTurns": {"const": 0}}},
    "quality": {"type": "object", "additionalProperties": false, "required": ["rawScore", "officialScore", "evaluationPath", "findings"], "properties": {"rawScore": {"type": ["integer", "null"], "minimum": 0, "maximum": 100}, "officialScore": {"type": ["integer", "null"], "minimum": 0, "maximum": 100}, "evaluationPath": {"type": ["string", "null"]}, "findings": {"type": "array"}}},
    "fidelity": {"type": "object", "additionalProperties": false, "required": ["status", "evidencePath"], "properties": {"status": {"enum": ["pending", "engaged", "completed", "activation_failed", "runtime_failed", "not_applicable"]}, "evidencePath": {"type": "string"}, "lifecycle": {"type": "object"}}},
    "usability": {"type": "object", "additionalProperties": false, "required": ["automaticDiscovery", "methodOperations", "clarifications", "methodErrors", "timeToFirstProductEditMs", "terminalLifecycle", "browserUsed"], "properties": {"automaticDiscovery": {"type": "boolean"}, "methodOperations": {"type": "integer", "minimum": 0}, "clarifications": {"type": "integer", "minimum": 0, "maximum": 2}, "methodErrors": {"type": "integer", "minimum": 0}, "timeToFirstProductEditMs": {"type": "integer", "minimum": 0}, "terminalLifecycle": {"type": "boolean"}, "browserUsed": {"const": false}}},
    "validity": {"type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": {"status": {"enum": ["draft", "valid_first_pass", "invalid_infrastructure", "invalid_organizer_design", "blocked"]}, "reason": {"type": "string"}}}
  }
}
